{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectvault",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "projectvault", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "projectvault-files" }],
  "observability": { "enabled": true }
}
